datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  Business      Business[]
  Form          Form[]
  role          Role       @default(USER)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id           String   @id @default(cuid())
  name         String
  description  String?
  logo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      String   @map("ownerId")
  creationDate DateTime
  entityType   String
  forms        Form[]
}

enum FilingType {
  INITIAL
  CORRECT
  UPDATE
  NEW_EXEMPT
}

enum FillingStatus {
  DRAFT
  INREVIEW
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

model Form {
  id         String        @id @default(cuid())
  version    Int           @default(autoincrement())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  owner      User          @relation(fields: [ownerId], references: [id])
  ownerId    String        @map("ownerId")
  business   Business      @relation(fields: [businessId], references: [id])
  businessId String
  status     FillingStatus @default(DRAFT)
  fi         FiForm?
  rc         RcForm?
  ca         caForm[]
  bo         boForm[]
}

model FiForm {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  form            Form       @relation(fields: [formId], references: [id])
  formId          String     @unique
  filingType      FilingType
  legalName       String
  taxType         String
  taxId           String
  taxJurisdiction String
}

model RcForm {
  id                               String   @id @default(cuid())
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
  form                             Form     @relation(fields: [formId], references: [id])
  formId                           String   @unique
  isForeignPooledInvestmentVehicle Boolean
  isRequestingId                   Boolean
  legalName                        String
  alternateNames                   String[]
  taxType                          String
  taxId                            String
  taxJurisdiction                  String
  jurisdiction                     String
  domesticState                    String?
  domesticTribalJurisdiction       String?
  domesticOtherTribe               String
  foreignFirstState                String
  foreignTribalJurisdiction        String
  foreignOtherTribe                String
  country                          String
  address                          String
  city                             String
  state                            String
  zip                              String
}

enum AddressType {
  BUSINESS
  RESIDENTIAL
}

model caForm {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  form                  Form                @relation(fields: [formId], references: [id])
  formId                String
  fincenId              String
  lastName              String
  middleName            String
  firstName             String
  suffix                String
  dob                   DateTime
  addressType           AddressType
  country               String
  state                 String
  address               String
  city                  String
  zip                   String
  identification        Identification      @relation(fields: [identificationId], references: [id])
  identificationId      String              @unique @map("identificationId")
  identifyingDocument   IdentifyingDocument @relation(fields: [identifyingDocumentId], references: [id])
  identifyingDocumentId String              @unique @map("identifyingDocumentId")
}

model boForm {
  id                          String               @id @default(cuid())
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  form                        Form                 @relation(fields: [formId], references: [id])
  formId                      String               @unique
  isParentGuardianInformation Boolean?
  fincenId                    String?
  isExemptEntity              Boolean
  lastName                    String
  middleName                  String?
  firstName                   String?
  suffix                      String?
  dob                         DateTime?
  country                     String?
  state                       String?
  address                     String?
  city                        String?
  zip                         String?
  identification              Identification?      @relation(fields: [identificationId], references: [id])
  identificationId            String?              @unique @map("identificationId")
  identifyingDocument         IdentifyingDocument? @relation(fields: [identifyingDocumentId], references: [id])
  identifyingDocumentId       String?              @unique @map("identifyingDocumentId")
}

model Identification {
  id           String  @id @default(cuid())
  type         String
  ID           String
  jurisdiction String
  state        String?
  localTribal  String?
  otherTribe   String?
  image        String
  caForm       caForm?
  boForm       boForm?
}

model IdentifyingDocument {
  id     String  @id @default(cuid())
  name   String
  size   Int
  type   String
  caForm caForm?
  boForm boForm?
}
